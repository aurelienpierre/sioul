<!-- Sioul's Android manifest: Qt 6.11's own (qtbase, src/android/templates),
     with Sioul's name and icon, the network, the keyboard pushing the window
     up rather than covering it, no cloud backup, the doses' alarms, the
     alarm at waking, the events' reminders, and the pauses' do-not-disturb,
     tile and shortcut.
     androiddeployqt fills the "INSERT" parts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aurelienpierre.sioul"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <!-- Mail, calendars, the weather: the Internet. The network's DNS servers,
         for the checks on senders: the network's state. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The sharing folder (and the notes) your sync app carries, read by their
         path: "All files access" from Android 11, the storage permission before. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Doses reminded while Sioul is away (docs/android.md): each coming dose
         given to Android's alarm clock, on time ("Alarms & reminders": yours
         to take back on Android 12, given from Android 13), and again after a
         restart; the reminders, asked for from Android 13. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The alarm at waking (docs/android.md, "Waking"): Android's alarm
         clock (exact alarms, above), its screen over the lock screen, its
         ringer in the foreground while it rings (from Android 14, the type
         alarms keep ringing with, allowed to apps with exact alarms), the
         phone kept awake meanwhile. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The pauses' do-not-disturb (docs/android.md, "Pauses"): Sioul's own
         modes, which need "Do Not Disturb access", a switch you turn on in
         Android's settings (this line alone gives nothing). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Do-not-disturb on every device (docs/android.md, "In the background"):
         the service that keeps this phone in step with your other devices
         while Sioul is closed, in the foreground with one quiet notification,
         asked to be let run in the background; your contacts read (never
         written) to say who on your list of people is not starred here. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The sync apps asked to look for changes now rather than at their next
         round (crates/sioul-app/src/share.rs, android/main.cpp): Murena's
         eDrive, which carries the sharing folder on /e/OS, every half hour. -->
    <queries>
        <package android:name="foundation.e.drive" />
    </queries>
    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />
    <!-- Mail, notes, health readings and passwords stay on the phone: no cloud
         backup (res/xml/sioul_data_extraction_rules.xml). -->
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="Sioul"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/sioul_data_extraction_rules"
        android:enableOnBackInvokedCallback="false">
        <!-- Made as the process starts, before Qt: Qt's accessibility kept for
             screen readers (StartChoices.java). -->
        <provider
            android:name="com.aurelienpierre.sioul.StartChoices"
            android:authorities="com.aurelienpierre.sioul.start"
            android:exported="false"
            android:initOrder="100" />
        <activity
            android:name="org.qtproject.qt.android.bindings.QtActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="Sioul"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

          <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

          <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />

          <!-- "Pause" at a long press on the icon, or on the home screen
               (res/xml/sioul_shortcuts.xml, PauseOpener.java); your addresses
               as the share sheet's direct targets, and at the same long
               press (its <share-target>, MailShortcuts.java). -->
          <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/sioul_shortcuts" />
        </activity>

        <!-- Measurable with Android's profiler (simpleperf) from a computer
             plugged in, as for Sioul's start; nothing else is opened by it. -->
        <profileable android:shell="true" />

        <!-- Files handed to other apps ("Open with…"), through Qt's provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>

        <!-- Sioul's card on the home screen (package/src/com/aurelienpierre/
             sioul/HomeCard.java; docs/android.md, "The card on the home
             screen"): drawn from what Sioul wrote, when Sioul says so (an
             explicit broadcast of its own) and at each change of time it gave
             ahead; again after a restart or an update. Not exported: the
             system's widget service reaches it all the same. -->
        <receiver
            android:name="com.aurelienpierre.sioul.HomeCard"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sioul_home_card_info" />
        </receiver>
        <!-- The mail card and the agenda card: one part of the card's list
             alone (HomeCardMail.java, HomeCardAgenda.java), drawn with it. -->
        <receiver
            android:name="com.aurelienpierre.sioul.HomeCardMail"
            android:label="@string/sioul_home_card_mail_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sioul_home_card_mail_info" />
        </receiver>
        <receiver
            android:name="com.aurelienpierre.sioul.HomeCardAgenda"
            android:label="@string/sioul_home_card_agenda_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sioul_home_card_agenda_info" />
        </receiver>
        <!-- The rows of the cards' lists, the Porch's latest messages and the
             coming events (HomeCardService.java, HomeCardRows.java): bound by
             the system's widget service alone (its permission). -->
        <service
            android:name="com.aurelienpierre.sioul.HomeCardService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <!-- A line of the card tapped: the Porch or a message on it, Now on
             its step, the Agenda or an event in it, kept for Sioul, which
             comes up on it (HomeCardOpener.java); never shown itself. -->
        <activity
            android:name="com.aurelienpierre.sioul.HomeCardOpener"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />
        <!-- A dose's alarm, and its reminder's "Taken" (package/src/com/
             aurelienpierre/sioul/DoseReceiver.java): sent by Android's alarm
             clock and by the reminder, by no other app. -->
        <receiver
            android:name="com.aurelienpierre.sioul.DoseReceiver"
            android:exported="false" />
        <!-- The alarms given again after a restart, an update, or "Alarms &
             reminders" allowed again (DoseBootReceiver.java). -->
        <receiver
            android:name="com.aurelienpierre.sioul.DoseBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- The time running's buttons, Pause, Go on and Stop (package/src/
             com/aurelienpierre/sioul/TimeReceiver.java): sent by its
             notification, by no other app. -->
        <receiver
            android:name="com.aurelienpierre.sioul.TimeReceiver"
            android:exported="false" />
        <!-- The alarm at waking (package/src/com/aurelienpierre/sioul/
             Wake*.java): its ring, the question before it, Stop and 10 min
             later, sent by Android's alarm clock and its notification; the
             phone started (before its first unlock too: directBootAware, the
             list kept where the phone reads it then), Sioul updated, the time
             or the zone changed, "Alarms & reminders" allowed again. -->
        <receiver
            android:name="com.aurelienpierre.sioul.WakeReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- The ring itself, in the foreground while it rings (WakeRinger.java). -->
        <service
            android:name="com.aurelienpierre.sioul.WakeRinger"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="systemExempted" />
        <!-- Over the lock screen as it rings: the time, Stop, 10 min later (WakeScreen.java). -->
        <activity
            android:name="com.aurelienpierre.sioul.WakeScreen"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:directBootAware="true"
            android:exported="false" />
        <!-- A reminder tapped: its dose kept for Sioul, which comes up on its
             question (DoseOpener.java); never shown itself. -->
        <activity
            android:name="com.aurelienpierre.sioul.DoseOpener"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />
        <!-- "Pause" pressed on the tile or the shortcut: kept for Sioul, which
             comes up on the pause (PauseOpener.java); never shown itself. Not
             exported: no other app can start a pause. -->
        <activity
            android:name="com.aurelienpierre.sioul.PauseOpener"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />
        <!-- "Pause" among the quick settings (PauseTile.java): bound by the
             system alone (its permission). -->
        <service
            android:name="com.aurelienpierre.sioul.PauseTile"
            android:label="@string/sioul_pause"
            android:icon="@drawable/sioul_pause"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- What other apps hand Sioul to write (ShareActivity.java,
             docs/android.md, "Sharing"): files and text shared to it, or to
             one of your addresses straight from the share sheet; mailto:
             links, from a browser too. Each becomes a draft in Sioul, which
             opens; nothing is sent until you press Send. Translucent, never
             shown, and kept (no noHistory) behind Sioul's window the moment
             the shared files take to open: Android's leave to read them goes
             with it, so it is not made again when the screen turns. -->
        <activity
            android:name="com.aurelienpierre.sioul.ShareActivity"
            android:label="Sioul"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
        </activity>
        <!-- Reminders before events (package/src/com/aurelienpierre/sioul/
             EventAlarms.java, EventReceiver.java; docs/android.md, "Events"):
             a reminder's time and the daily look, sent by Android's alarm
             clock, by no other app; the phone started (once unlocked: the
             events are in Sioul's files), Sioul updated, the time or the zone
             changed, "Alarms & reminders" allowed again, each giving the
             alarms again. -->
        <receiver
            android:name="com.aurelienpierre.sioul.EventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- An event's reminder or new mail's notification tapped: the event,
             or the Porch, kept for Sioul, which comes up on it
             (ReminderOpener.java); never shown itself. -->
        <activity
            android:name="com.aurelienpierre.sioul.ReminderOpener"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />
        <!-- Do-not-disturb on every device (docs/android.md, "In the
             background"): the service that keeps this phone in step while
             Sioul is closed (StepService.java), in a process of its own, since
             Qt's window ends its whole process as it closes; its alarm, and the
             phone's restart or Sioul's update, which start it again if it was
             on (StepReceiver.java). By no other app. -->
        <service
            android:name="com.aurelienpierre.sioul.StepService"
            android:process=":steps"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the person's do-not-disturb and the people allowed through it in step with their other devices, through the folder their own sync app carries, while the app is closed." />
        </service>
        <receiver
            android:name="com.aurelienpierre.sioul.StepReceiver"
            android:process=":steps"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Do-not-disturb applied in Sioul's own process, where its modes
             are kept (DndReceiver.java): asked by the service, at its next
             end, after a restart or an update. By no other app. -->
        <receiver
            android:name="com.aurelienpierre.sioul.DndReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Calls screened (docs/android.md, "Calls"; CallScreen.java): Android
             asks Sioul, as its "Caller ID & spam app" (Android 10 and later,
             once you say yes), about each call, and Sioul answers from the
             table it wrote ahead, in a process of its own that never loads
             Qt: the call rings, or is refused and goes to your voicemail.
             Bound by Android's phone service alone (its permission). -->
        <service
            android:name="com.aurelienpierre.sioul.CallScreen"
            android:process=":calls"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <!-- Android's question "Set Sioul as your caller ID & spam app?",
             asked from Settings ▸ Calls (CallsSetup.java): never shown itself. -->
        <activity
            android:name="com.aurelienpierre.sioul.CallsSetup"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="false" />
        <!-- Other apps' notifications held until their time (docs/android.md,
             "Notifications from other apps"; AppNotes.java): Android's
             notification listener, bound by the system alone (its
             permission) once you give Sioul "Notification access" in
             Android's settings (this line alone gives nothing). In a process
             of its own, with Sioul's library and without Qt: Qt's window ends
             its process as it closes, which would unbind it, and the
             background service's process may be off. Never sent ongoing
             notifications (a call, music, a download): they are never held. -->
        <service
            android:name="com.aurelienpierre.sioul.AppNotes"
            android:process=":listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing" />
        </service>
    </application>
</manifest>
