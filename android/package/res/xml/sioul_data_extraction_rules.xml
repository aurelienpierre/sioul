<!-- Android 12 and later. Sioul keeps mail, notes, health readings and
     passwords: none of it goes to a cloud backup. Moving to a new phone,
     cable or Wi-Fi between the two, takes everything but the passwords,
     which only the old phone's KeyStore can read, and the sites' sign-ins,
     which are this device's: you type them again. Before Android 12,
     android:allowBackup="false" keeps both from leaving. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <!-- The sites' sign-ins and what they keep (the system's web view's
             folder: cookies, storage, service workers, caches) stay on this
             device: the new one signs in again (SiteScreen.java). -->
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
