<!-- Sioul's mail card (HomeCardMail.java): the Porch's latest messages alone,
     as the full card lists them; about four cells by three, resizable; drawn
     as the full card is (HomeCard.java). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/sioul_home_card_mail_description"
    android:initialLayout="@layout/sioul_home_card"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
