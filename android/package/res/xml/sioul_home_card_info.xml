<!-- Sioul's full card on the home screen (HomeCard.java, HomeCardToday.java):
     today (the date, the weather), then what the Porch has for you, then Now;
     the mail and the events have cards of their own. About four cells by
     four, resizable; drawn when Sioul writes it and at each change of time it
     gave ahead, never on a timer of Android's (updatePeriodMillis 0). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/sioul_home_card_description"
    android:initialLayout="@layout/sioul_home_card_today"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
