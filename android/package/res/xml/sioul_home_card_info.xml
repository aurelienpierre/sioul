<!-- Sioul's card on the home screen (HomeCard.java): about four cells by two,
     resizable; drawn when Sioul writes it and at each change of time it gave
     ahead, never on a timer of Android's (updatePeriodMillis 0). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/sioul_home_card_description"
    android:initialLayout="@layout/sioul_home_card"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
