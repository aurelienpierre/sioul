<!-- Sioul's cards on the home screen (HomeCard.java, HomeCardRows.java):
     Sioul's light colours (crates/sioul-app/qml/Theme.qml: surface, text,
     muted, accent, line), the dark ones in values-night; their spacing; the
     names and lines the launcher's list of widgets shows, in English only:
     Qt's Gradle template keeps the English resources alone (resConfig "en"),
     so the cards' own words are Rust's and Java's. -->
<resources>
    <color name="sioul_home_card_surface">#fbfaf7</color>
    <color name="sioul_home_card_text">#2d2a26</color>
    <color name="sioul_home_card_muted">#6b655c</color>
    <color name="sioul_home_card_accent">#4c6b5c</color>
    <color name="sioul_home_card_line">#e2dccf</color>
    <dimen name="sioul_home_card_radius">16dp</dimen>
    <dimen name="sioul_home_card_padding">16dp</dimen>
    <dimen name="sioul_home_card_gap">6dp</dimen>
    <dimen name="sioul_home_card_block_radius">6dp</dimen>
    <string name="sioul_home_card_description">Today\'s date and weather, then a dose due, a code, reminders, and your next step.</string>
    <string name="sioul_home_card_mail_label">Sioul — Mail</string>
    <string name="sioul_home_card_mail_description">The Porch\'s latest messages.</string>
    <string name="sioul_home_card_agenda_label">Sioul — Agenda</string>
    <string name="sioul_home_card_agenda_description">Your coming events, day by day.</string>
</resources>
