<!-- A message in the home-screen card's list (HomeCardRows.java), as a mail
     card shows it: a thin bar in its account's colour; the sender, in bold
     while it is not read, and when it came, on the right; its subject; a line
     of its text; a line under it. A tap opens it on the Porch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sioul_home_card_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/sioul_home_card_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/sioul_home_card_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="@dimen/sioul_home_card_padding"
        android:paddingTop="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/sioul_home_card_sender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/sioul_home_card_text"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/sioul_home_card_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/sioul_home_card_muted"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/sioul_home_card_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sioul_home_card_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/sioul_home_card_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sioul_home_card_muted"
            android:textSize="13sp" />
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="@color/sioul_home_card_line"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
