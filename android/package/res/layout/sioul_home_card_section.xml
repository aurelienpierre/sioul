<!-- A heading of the home-screen card's list (HomeCardRows.java): "Mail",
     "Agenda". A tap opens the Porch, or the Agenda. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sioul_home_card_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="sans-serif-medium"
    android:maxLines="1"
    android:paddingStart="@dimen/sioul_home_card_padding"
    android:paddingEnd="@dimen/sioul_home_card_padding"
