<!-- Sioul's card on the home screen (HomeCard.java, docs/android.md "The card
     on the home screen"), in Sioul's colours, light or dark as the phone is,
     rounded as the launcher's cards. On top, one short line each, shown or
     left out as the card's height allows: what now is for (the card's age
     beside it, once it is old), do-not-disturb, a code you asked for, the next
     step, a dose due. Under them, a list that scrolls (HomeCardRows.java): the
     Porch's latest messages, then the coming events. No icon, no count, no
     button. The mail card and the agenda card show the list alone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/sioul_home_card_background"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/sioul_home_card_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sioul_home_card_padding"
        android:paddingEnd="@dimen/sioul_home_card_padding"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <!-- What now is for; how old the card is, once it is. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/sioul_home_card_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/sioul_home_card_text"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/sioul_home_card_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/sioul_home_card_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Under it, the do-not-disturb on every device, when switched on or for a focus session. -->
        <TextView
            android:id="@+id/sioul_home_card_dnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sioul_home_card_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- A code you asked a site for, while it is valid; its warning when its sender is not verified. -->
        <TextView
            android:id="@+id/sioul_home_card_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sioul_home_card_text"
            android:textSize="13sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/sioul_home_card_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sioul_home_card_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- The next step; why it comes now is on Now, a tap away. -->
        <TextView
            android:id="@+id/sioul_home_card_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sioul_home_card_accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- A dose due, quietly. -->
        <TextView
            android:id="@+id/sioul_home_card_dose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sioul_home_card_text"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The Porch's latest messages, then the coming events (HomeCardRows.java). -->
    <ListView
        android:id="@+id/sioul_home_card_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="10dp"
        android:scrollbarStyle="outsideOverlay" />
</LinearLayout>
