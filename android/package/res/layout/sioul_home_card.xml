<!-- Sioul's mail card and agenda card on the home screen (HomeCard.java,
     docs/android.md "The card on the home screen"), in Sioul's colours, light
     or dark as the phone is, rounded as the launcher's cards: a list that
     scrolls (HomeCardRows.java), the Porch's latest messages or the coming
     events. No icon, no count, no button. The full card is
     sioul_home_card_today.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/sioul_home_card_background"
    android:clipToOutline="true">

    <!-- The Porch's latest messages, or the coming events (HomeCardRows.java). -->
    <ListView
        android:id="@+id/sioul_home_card_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="10dp"
        android:scrollbarStyle="outsideOverlay" />
</LinearLayout>
